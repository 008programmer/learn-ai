{
  "model": "claude-sonnet-4-5",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet ef:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(bun install:*)",
      "Bash(bun run:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(dotnet ef database drop:*)",
      "WebFetch(*)"
    ]
  }
}